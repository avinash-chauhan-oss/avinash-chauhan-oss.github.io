---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Avinash Chauhan</div>
    <div class="text-3xl py-3 font-bold">Quantitative Strategist & Mathematics Undergraduate</div>
    <div class="py-2">
      <p class="text-lg">
        I am a BS-MS student specializing in i2 Mathematics at IISER Thiruvananthapuram. I bridge rigorous mathematical frameworks with practical corporate business applications. My core focus lies in quantitative finance, applying game theory and stochastic processes to develop robust trading models and predictive Alphas on platforms like WorldQuant BRAIN. Alongside my mathematical foundation, I build highly optimized, algorithmic solutions using vanilla Python.
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://linkedin.com/" target="_blank"> Let's connect!</a>
      <a href="https://github.com/avinash-chauhan-oss" target="_blank" class="btn btn-outline ml-5">
        My GitHub
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Core Projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="Market Making with Reinforcement Learning"
    img="/post_img.webp"
    desc="Implementing Soft Actor-Critic (SAC) algorithms for optimal market-making and managing stochastic inventory risk."
    url="https://github.com/avinash-chauhan-oss/RL-for-Market-Making"
    badge="RL / FINANCE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Classical-Quantum Hybrid Classifier"
    img="/post_img.webp"
    desc="Developing a hybrid quantum-classical machine learning model leveraging variational circuits using PennyLane."
    url="https://github.com/avinash-chauhan-oss/Anvesha-2025-Science-Expo-Project"
    badge="QUANTUM"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Lotka Volterra Simulations"
    img="/post_img.webp"
    desc="Simulating predator-prey ecosystem interactions and population cycles through the numerical solution of ordinary differential equations."
    url="https://github.com/avinash-chauhan-oss/Lotka-Volterra-Simulation"
    badge="FINANCE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Customer Segmentation Analysis"
    img="/post_img.webp"
    desc="Applying exploratory data analysis and clustering techniques to categorize consumer behavior patterns and purchasing segments."
    url="https://github.com/avinash-chauhan-oss/Customer-Segmentation-Analysis"
    badge="FINANCE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Malaria Parasite Detection via CNNs"
    img="/post_img.webp"
    desc="Building convolutional neural network models for automated image processing and medical parasite classification."
    url="https://github.com/avinash-chauhan-oss/Malaria-Detection-CNN"
    badge="AI / CV"
  />
  <div class="divider my-0"></div>

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>